{
  "name": "Atlas Studio - Publicação Multiplataforma (YouTube, Facebook, TikTok)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "atlas-publish-video",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook-in",
      "name": "Webhook - Atlas Studio",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "atlas-publish-video"
    },
    {
      "parameters": {
        "jsCode": "const incoming = $input.first().json.body ?? $input.first().json;\nconst p = incoming.publication;\nif (!p?.channel || !p?.videoUrl || !p?.title) throw new Error('Publicação incompleta.');\nconst future = p.publishAt && new Date(p.publishAt).getTime() > Date.now() + 10 * 60 * 1000;\nconst youtubeMode = incoming.youtubeMode || 'scheduled';\nreturn [{json:{...p,jobId:incoming.jobId,youtubeMode,youtubePrivacy:youtubeMode==='public'?'public':'private',youtubePublishAt:youtubeMode==='scheduled'&&future?p.publishAt:undefined}}];"
      },
      "id": "node-format-publication",
      "name": "Formatar Publicação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "youtube",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "YouTube"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "facebook",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Facebook"
            }
          ]
        },
        "options": {}
      },
      "id": "node-channel-router",
      "name": "Roteador de Canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.videoUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 900000
        }
      },
      "id": "node-download-video",
      "name": "Baixar Vídeo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        180
      ]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Formatar Publicação').item.json.title }}",
        "categoryId": "27",
        "binaryProperty": "data",
        "options": {
          "description": "={{ $('Formatar Publicação').item.json.description }}",
          "privacyStatus": "={{ $('Formatar Publicação').item.json.youtubePrivacy }}",
          "publishAt": "={{ $('Formatar Publicação').item.json.youtubePublishAt }}",
          "notifySubscribers": false,
          "selfDeclaredMadeForKids": false,
          "tags": "={{ ($('Formatar Publicação').item.json.tags || []).join(',') }}",
          "defaultLanguage": "en"
        }
      },
      "id": "node-youtube-long",
      "name": "YouTube - Publicar Vídeo",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        1120,
        180
      ],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const source = $('Formatar Publicação').first().json;\nconst uploaded = $input.first().json;\nreturn [{json:{...source,videoId:uploaded.id || uploaded.uploadId}}];"
      },
      "id": "node-restore-youtube",
      "name": "Preparar Complementos YouTube",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ Boolean($json.thumbnailUrl && $json.kind === \"long\") }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "node-if-thumbnail",
      "name": "Tem Capa?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        180
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.thumbnailUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "thumbnail"
            }
          },
          "timeout": 120000
        }
      },
      "id": "node-download-thumbnail",
      "name": "Baixar Capa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1740,
        80
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/upload/youtube/v3/thumbnails/set?videoId={{ $json.videoId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "thumbnail",
        "options": {}
      },
      "id": "node-upload-thumbnail",
      "name": "YouTube - Enviar Capa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1940,
        80
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const source = $('Preparar Complementos YouTube').first().json;\nif (!source.captionVtt) return [{json:{...source,captionReady:false}}];\nconst boundary = 'atlas_caption_' + Date.now();\nconst metadata = JSON.stringify({snippet:{videoId:source.videoId,language:'en',name:'English',isDraft:false}});\nconst body = '--'+boundary+'\\r\\nContent-Type: application/json; charset=UTF-8\\r\\n\\r\\n'+metadata+'\\r\\n--'+boundary+'\\r\\nContent-Type: text/vtt; charset=UTF-8\\r\\n\\r\\n'+source.captionVtt+'\\r\\n--'+boundary+'--';\nreturn [{json:{...source,captionReady:true,captionContentType:'multipart/related; boundary='+boundary},binary:{caption:{data:Buffer.from(body).toString('base64'),mimeType:'application/octet-stream',fileName:'captions.multipart'}}}];"
      },
      "id": "node-build-caption",
      "name": "Preparar Legenda YouTube",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.captionReady }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "node-if-caption",
      "name": "Tem Legenda?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2360,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/youtube/v3/captions?uploadType=multipart&part=snippet",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "={{ $json.captionContentType }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "caption",
        "options": {}
      },
      "id": "node-upload-caption",
      "name": "YouTube - Enviar Legenda",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2560,
        100
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const source = $('Preparar Complementos YouTube').first().json;\nreturn [{json:{ok:true,channel:'youtube',kind:source.kind,id:source.videoId,publishAt:source.publishAt,privacyStatus:source.youtubePrivacy}}];"
      },
      "id": "node-youtube-result",
      "name": "Resultado YouTube",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2780,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/me/videos",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"{{ $json.title }}\",\n  \"description\": \"{{ $json.description }}\",\n  \"file_url\": \"{{ $json.videoUrl }}\",\n  \"published\": {{ new Date($json.publishAt).getTime() > Date.now() + 600000 ? false : true }},\n  \"scheduled_publish_time\": {{ Math.floor(new Date($json.publishAt).getTime() / 1000) }}\n}",
        "options": {}
      },
      "id": "node-facebook-post",
      "name": "Facebook - Vídeos & Reels",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        420
      ],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const response=$input.first().json;const source=$('Formatar Publicação').first().json;return [{json:{ok:!response.error,channel:'facebook',kind:source.kind,id:response.id||response.video_id||null,publishAt:source.publishAt,error:response.error?.message}}];"
      },
      "id": "node-facebook-result",
      "name": "Resultado Facebook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/video/init/",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"post_info\": {\n    \"title\": \"{{ $json.longVideo.title }}\",\n    \"privacy_level\": \"PUBLIC_TO_EVERYONE\"\n  },\n  \"source_info\": {\n    \"source\": \"PULL_FROM_URL\",\n    \"video_url\": \"{{ $json.longVideo.videoUrl }}\"\n  }\n}",
        "options": {}
      },
      "id": "node-tiktok-post",
      "name": "TikTok - Publicar Vídeo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        440
      ],
      "disabled": true
    }
  ],
  "connections": {
    "Webhook - Atlas Studio": {
      "main": [
        [
          {
            "node": "Formatar Publicação",
            "type": "main",
